# Copy this file to .env in the project root and fill in your own values. Never commit .env.
# It is read as a Java properties file: write Windows paths with forward slashes (C:/app/...),
# because a backslash starts an escape sequence.
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=your_admin_user
DB_PASS=your_password

# Windows: DATAFILE_DIR=C:/app/oracle/oradata/XE/XEPDB1
DATAFILE_DIR=/opt/oracle/oradata/XE/XEPDB1
